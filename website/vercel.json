{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist/client",
  "framework": null,
  "redirects": [
    {
      "source": "/linux",
      "destination": "https://github.com/vverma022/helm/blob/main/docs/linux.md",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
